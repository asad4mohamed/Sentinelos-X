# Copy to .env (never commit .env). The key stays server-side; never ship it to the browser.

# --- NVIDIA (get a key at https://build.nvidia.com) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified with a live tool-calling request on 2026-11-07 (with one account). Listed in /v1/models != callable: nemotron-3-super-120b-a12b returned 404 for that account.
# Also worked with tools for that account: nvidia/nemotron-3.5-lightning-30b-a3b, nvidia/nemotron-3.5-super-vl-120b-a12b. Probe your own key.
NVIDIA_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b
# Optional JSON object merged into the request body (e.g. model-specific reasoning switches).
NVIDIA_EXTRA_BODY=
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=2048
NVIDIA_REQUEST_TIMEOUT_S=60
NVIDIA_MAX_RETRIES=3
NVIDIA_RETRY_BACKOFF_S=1.5

# --- Investigation limits ---
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_MODEL_TURNS=30
AGENT_MAX_INVESTIGATION_SECONDS=300
AGENT_TOOL_TIMEOUT_S=10
AGENT_MAX_LOG_RESULTS=50
AGENT_MAX_CONCURRENT_INVESTIGATIONS=2
AGENT_MAX_QUEUED_INVESTIGATIONS=20

# --- Data provider: "fixture" (synthetic, standalone) or "live" (not implemented yet) ---
AGENT_DATA_PROVIDER=fixture

# --- Approval / auth ---
# Shared secret between the main SentinelOS X backend and this service. Only the backend may know it.
AGENT_SERVICE_TOKEN=
# LOCAL DEMO ONLY. Trusts X-Demo-User / X-Demo-Role headers. NOT production-grade security.
AGENT_DEMO_MODE=false

# Comma-separated browser origins allowed to call this service directly. Empty = CORS disabled.
AGENT_CORS_ORIGINS=

LOG_LEVEL=INFO
