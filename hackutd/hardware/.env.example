# Copy to hardware/.env (git-ignored) and fill in. Never commit real values.
# Generate random tokens with:  python -c "import secrets; print(secrets.token_hex(24))"

# Shared secret the Arduino sends as X-Device-Token (must match BRIDGE_TOKEN in arduino_secrets.h). Min 16 chars.
SENTINEL_DEVICE_TOKEN=change-me-device-token-min-16-chars
# Operator-only token for /demo/* endpoints. Min 16 chars. Never flash this onto the board.
SENTINEL_ADMIN_TOKEN=change-me-admin-token-min-16-chars

# SpacetimeDB HTTP API (same server the UI uses)
SPACETIMEDB_URL=http://localhost:3000
SPACETIMEDB_DB=sentinelos-x
# Identity tokens from `curl -X POST http://localhost:3000/v1/identity` (one per identity).
# Gateway: announced as a hardware_gateway service and authorized by an Incident Commander in Settings -> Services.
SPACETIMEDB_GATEWAY_TOKEN=
# Optional analyst identity, only used by the legacy synthetic "A" key trigger.
SPACETIMEDB_TOKEN=

# Detection limits (applied by the SpacetimeDB module, not by the device)
SENSOR_TEMP_LIMIT_C=30
SENSOR_HUMIDITY_LIMIT_PCT=70
SENSOR_SILENT_AFTER_S=30
# Readings arriving faster than this are rejected with 429 (DHT11 cannot sample faster than ~1 Hz).
SENSOR_MIN_INTERVAL_S=0.5
