# Copy to services/.env (git-ignored). Never commit real values; never put secrets in frontend VITE_* vars.

# SpacetimeDB connection (both services)
SPACETIMEDB_HOST=ws://localhost:3000
SPACETIMEDB_DB_NAME=sentinelos-x

# Telemetry generator (optional; the built-in engine is on by default)
TELEMETRY_INTERVAL_MS=2000

# Nemotron agent — get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model availability is per account. The team's key returned 404 for nemotron-3-super-120b-a12b;
# nemotron-3-ultra-550b-a55b worked. Run `npm --prefix services run agent:check` to verify yours.
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_THINKING=false
NEMOTRON_TIMEOUT_MS=180000
# Retries for 429 / 5xx / network errors (exponential backoff, honours Retry-After, capped at 10 s)
NEMOTRON_MAX_RETRIES=2

# Investigation budgets (hard limits enforced in code)
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_SECONDS=300
